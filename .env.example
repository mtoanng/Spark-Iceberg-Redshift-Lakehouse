# ============================================================================
# AWS CONFIGURATION
# ============================================================================
# From: terraform output -raw aws_account_id
AWS_ACCOUNT_ID=123456789012
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1

# ============================================================================
# S3 CONFIGURATION
# ============================================================================
# From: terraform output -raw s3_bucket_name
S3_BUCKET=instacart-lakehouse-yourname
S3_RAW_PREFIX=raw/instacart
S3_WAREHOUSE_PREFIX=warehouse
# From: terraform output -raw s3_gold_path
S3_GOLD_PATH=s3://instacart-lakehouse-yourname/gold

# ============================================================================
# AWS GLUE CONFIGURATION
# ============================================================================
# From: terraform output -raw glue_database_name
GLUE_DATABASE=instacart_lakehouse_dev
# From: terraform output -raw glue_role_arn
GLUE_ROLE_ARN=arn:aws:iam::123456789012:role/GlueServiceRole-Instacart

# ============================================================================
# MONGODB CONFIGURATION (MongoDB Atlas recommended)
# ============================================================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DATABASE=instacart_warehouse

# ============================================================================
# DUCKDB CONFIGURATION
# ============================================================================
DUCKDB_PATH=warehouse/data/warehouse.db
USE_GLUE_CATALOG=true
# From: terraform output -raw duckdb_role_arn
DUCKDB_ROLE_ARN=arn:aws:iam::123456789012:role/GlueServiceRole-Instacart

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================================
# DBT CONFIGURATION
# ============================================================================
DBT_PROFILES_DIR=etl/dbt_project
DBT_GLUE_STAGING=s3://instacart-lakehouse-yourname/dbt-glue-staging/
