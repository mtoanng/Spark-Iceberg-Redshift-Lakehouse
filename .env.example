# Copy to .env only for a bounded remote development environment. Never commit .env.

# AWS / dbt-glue runtime
AWS_REGION=us-east-1
GLUE_ROLE_ARN=arn:aws:iam::<account-id>:role/<nyc-glue-role>
S3_GOLD_PATH=s3://<bucket>/warehouse/gold

# Airflow connection and Variable names used by etl/dags/nyc_hvfhs_monthly_dag.py
# Configure these in the deployed Airflow instance, not in Git:
#   connection: aws_default
#   nyc_landing_uri=s3://<bucket>/landing
#   nyc_taxi_zone_uri=s3://<bucket>/reference/taxi_zone_lookup.csv
#   nyc_taxi_zone_sha256=<sha256>
#   nyc_bronze_job_name=<nyc-bronze-job>
#   nyc_silver_job_name=<nyc-silver-job>
#   nyc_quality_checkpoint_job_name=<nyc-quality-checkpoint-job>
#   nyc_project_root=<absolute-deployment-path>
#   nyc_hvfhs_2024_01_sha256=<sha256>
#   nyc_hvfhs_2024_01_size_bytes=<bytes>

# The monthly source checksum and size are immutable audit facts. Add one pair
# per approved month only after measuring the uploaded source file.
