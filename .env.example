# AWS Configuration (S3 for Lakehouse Storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=instacart-lakehouse

# GCP Configuration (BigQuery for Analytics Serving)
GCP_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# BigQuery Configuration
BIGQUERY_DATASET_ID=instacart_lakehouse
BIGQUERY_LOCATION=US

# Spark Configuration
SPARK_HOME=/opt/spark
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g

# Airflow Configuration (if using)
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags

# MongoDB Configuration (optional)
MONGODB_ENABLED=false
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=instacart_catalog

# dbt Configuration
DBT_PROFILES_DIR=~/.dbt
DBT_TARGET=prod

# Kaggle API (store in ~/.kaggle/kaggle.json instead)
# KAGGLE_USERNAME=your-username
# KAGGLE_KEY=your-api-key
