# AWS Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET=instacart-lakehouse-xxxx

# Databricks Configuration
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_token_here
DATABRICKS_CLUSTER_ID=your_cluster_id_here

# MongoDB Configuration
MONGODB_URI=mongodb://admin:admin123@localhost:27017/
MONGODB_DATABASE=instacart_metadata
# For MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# S3 Paths
S3_RAW_PATH=s3a://instacart-lakehouse-xxxx/raw/instacart
S3_BRONZE_PATH=s3a://instacart-lakehouse-xxxx/bronze
S3_SILVER_PATH=s3a://instacart-lakehouse-xxxx/silver
S3_GOLD_PATH=s3://instacart-lakehouse-xxxx/gold

# dbt Configuration
DBT_PROFILES_DIR=~/.dbt

# Warehouse API
API_HOST=0.0.0.0
API_PORT=8000

# Local Data Path
LOCAL_DATA_PATH=./data

# DuckDB Configuration
DUCKDB_DEFAULT_ROW_LIMIT=10000
