# Copy locally to terraform.tfvars. Never commit credentials, state, or plans.
aws_region     = "us-east-1"
environment    = "dev"
project_name   = "nyc-hvfhs-lakehouse"
s3_bucket_name = "<globally-unique-private-bucket>"

# Existing network boundary for private MWAA and Redshift Serverless.
vpc_id = "vpc-xxxxxxxx"
private_subnet_ids = [
  "subnet-private-az-a",
  "subnet-private-az-b",
]

athena_results_prefix       = "athena-results"
athena_bytes_scanned_cutoff = 104857600
spark_package_path          = "build/nyc_spark_jobs.zip"
mwaa_environment_class      = "mw1.small"
mwaa_max_workers            = 2
