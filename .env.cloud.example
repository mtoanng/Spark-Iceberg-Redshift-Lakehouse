# Non-secret configuration for the bounded AWS deployment. Use the SDK default
# credential chain locally and the temporary runner instance profile remotely.
AWS_REGION=us-east-1
GLUE_CATALOG_NAME=AwsDataCatalog
GLUE_GOLD_DATABASE=gold
ATHENA_WORKGROUP=<project-environment-gold-workgroup>
ATHENA_RESULTS_PREFIX=athena-results
ATHENA_BYTES_SCANNED_CUTOFF=104857600
# Airflow runner/DAG environment contract. Values are supplied by deployment
# configuration or AIRFLOW_VAR_* settings, never static AWS keys.
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/project/etl/dags
AIRFLOW_VAR_NYC_LANDING_URI=s3://<bucket>/landing
AIRFLOW_VAR_NYC_TAXI_ZONE_URI=s3://<bucket>/reference/taxi_zone_lookup.csv
AIRFLOW_VAR_NYC_TAXI_ZONE_SHA256=<sha256>
AIRFLOW_VAR_NYC_PROJECT_ROOT=/opt/airflow/project
AIRFLOW_VAR_NYC_BRONZE_JOB_NAME=<bronze-job>
AIRFLOW_VAR_NYC_GREAT_EXPECTATIONS_JOB_NAME=<ge-job>
AIRFLOW_VAR_NYC_SILVER_JOB_NAME=<silver-job>
AIRFLOW_VAR_NYC_QUALITY_CHECKPOINT_JOB_NAME=<post-gold-reconciliation-job>
AIRFLOW_VAR_GLUE_ROLE_ARN=<role-arn>
AIRFLOW_VAR_GLUE_GOLD_DATABASE=gold
AIRFLOW_VAR_ATHENA_WORKGROUP=<workgroup>
AIRFLOW_VAR_NYC_MANIFEST_URI=s3://<bucket>/manifests/<year>/<month>/<run-id>.json
AIRFLOW_VAR_NYC_GOLD_ROW_COUNT=<validated-gold-count>
AIRFLOW_VAR_ATHENA_SMOKE_ENABLED=false
