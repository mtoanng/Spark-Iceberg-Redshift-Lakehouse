# Airflow image for the NYC HVFHV orchestration plane.
# EMR Serverless PySpark runs remotely; this image does not start local Spark.
# This image is only for the Airflow orchestration plane.
FROM apache/airflow:3.3.0-python3.12

USER airflow

RUN mkdir -p /opt/airflow/runtime

COPY --chown=airflow:root requirements-airflow.txt /tmp/requirements-airflow.txt
RUN pip install --no-cache-dir -r /tmp/requirements-airflow.txt

COPY --chown=airflow:root etl /opt/airflow/project/etl
COPY --chown=airflow:root athena /opt/airflow/project/athena
COPY --chown=airflow:root scripts /opt/airflow/project/scripts
ENV PYTHONPATH="/opt/airflow/project"
ENV AIRFLOW__CORE__DAGS_FOLDER="/opt/airflow/project/etl/dags"

