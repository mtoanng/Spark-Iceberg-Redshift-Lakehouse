# Airflow image with Spark + Postgres providers for pipeline orchestration.
# Used by docker-compose or standalone Airflow deployments.
# (Not the Warehouse API — see Dockerfile.warehouse for that.)
FROM apache/airflow:2.9.0

USER airflow

RUN pip install --no-cache-dir \
    pyspark==3.5.0 \
    psycopg2-binary \
    apache-airflow-providers-apache-spark \
    apache-airflow-providers-postgres

