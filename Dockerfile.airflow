# Airflow image with Spark + Postgres providers for pipeline orchestration.
# Used by docker-compose or standalone Airflow deployments.
# This image is only for the Airflow orchestration plane.
FROM apache/airflow:3.3.0

USER airflow

RUN pip install --no-cache-dir \
    pyspark==3.5.0 \
    apache-airflow-providers-amazon

